# Dependencies
node_modules/

# Build output and Astro cache (regenerated by `npm run build`)
dist/
.astro/

# Netlify local state
.netlify/

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test output
tests/screens/
test-results/
playwright-report/

# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors and local tooling
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.claude/

# Original full-resolution campaign images. They stay on the local machine
# only and are the read-only source for `npm run images`.
/assets/
/nova-studio-interior.png.png

# NOTE: public/img/ holds the optimised production image derivatives the
# website serves. It is deliberately NOT ignored.
